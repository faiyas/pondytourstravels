# Root .gitignore for pondytourstravels

# Environment files with secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
venv/
ENV/
env/
*.sqlite3
backend/static_collected/
backend/media/
backend/logs/
*.log

# Node & Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Compressed Archives & Backups
*.zip
*.rar
*.tar.gz
dist.zip
dist.rar
assets_backup/

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

