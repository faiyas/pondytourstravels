# Backend Production Environment Variables Template
# Copy this file to .env and set your production values
SECRET_KEY=change-this-to-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=*
PORT=8001

# PostgreSQL Configuration
DB_NAME=pondy_db
DB_USER=pondy_user
DB_PASSWORD=your_secure_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True

